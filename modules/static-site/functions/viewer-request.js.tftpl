// Viewer-request function for ${apex}:
//  1. www.${apex} is 301'd to the apex, path and query string preserved.
//  2. "/dir/" serves "/dir/index.html" (CloudFront's default root object only
//     covers "/"), and "/dir" is 301'd to "/dir/" so each page has one URL.
function handler(event) {
  var request = event.request;
  var host = request.headers.host ? request.headers.host.value.toLowerCase() : '';

  if (host === 'www.${apex}') {
    return redirect('https://${apex}' + request.uri + query(request.querystring));
  }

  var uri = request.uri;
  if (uri.charAt(uri.length - 1) === '/') {
    if (uri !== '/') request.uri = uri + 'index.html';
  } else if (uri.split('/').pop().indexOf('.') === -1) {
    return redirect(uri + '/' + query(request.querystring));
  }
  return request;
}

function redirect(location) {
  return {
    statusCode: 301,
    statusDescription: 'Moved Permanently',
    headers: { location: { value: location }, 'cache-control': { value: 'max-age=3600' } }
  };
}

// CloudFront passes the query string as an object; multiValue covers ?a=1&a=2.
function query(qs) {
  var parts = [];
  for (var key in qs) {
    var p = qs[key];
    var values = p.multiValue ? p.multiValue.map(function (v) { return v.value; }) : [p.value];
    values.forEach(function (v) {
      parts.push(encodeURIComponent(key) + (v ? '=' + encodeURIComponent(v) : ''));
    });
  }
  return parts.length ? '?' + parts.join('&') : '';
}
